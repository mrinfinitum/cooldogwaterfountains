
# Public address of this Next.js site (used for canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.cooldogwaterfountains.com

REVALIDATE_SECRET=change-me

# Sanity (project ID and dataset are public; the write token is server-only)
NEXT_PUBLIC_SANITY_PROJECT_ID=2jkxn6fw
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Stripe (checkout). Use test keys (sk_test_/pk_test_) until launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
