# WordPress / WooCommerce site that serves as the CMS (no trailing slash).
# Once this Next.js site takes over the main domain, move WordPress to a
# subdomain (e.g. https://cms.cooldogwaterfountains.com) and set it here.
WORDPRESS_URL=https://www.cooldogwaterfountains.com

# Public address of this Next.js site (used for canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.cooldogwaterfountains.com

# Shared secret WordPress sends to /api/revalidate to refresh content instantly.
REVALIDATE_SECRET=change-me
