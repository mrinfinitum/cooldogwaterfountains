
# Public address of this Next.js site (used for canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.cooldogwaterfountains.com

# Shared with the CMS storefront's "Refresh secret".
REVALIDATE_SECRET=change-me

# Headless Commerce CMS (WordPress + WooCommerce). The API key is this storefront's
# key from the CMS (Products → Storefronts → Cool Dog Water Fountains).
CMS_URL=https://dog-park-company-cms.mystagingwebsite.com
CMS_API_KEY=

# Stripe (checkout). Use test keys (sk_test_/pk_test_) until launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Stripe webhook endpoint /api/stripe/webhook/
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=
